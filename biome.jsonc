{
  "$schema": "https://biomejs.dev/schemas/2.2.4/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/packages/ui/src/components/**/*.tsx",
      "!**/packages/ui/src/components/**/*.ts"
    ]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": {
        "noArrayIndexKey": "off"
      },
      "performance": {
        "noAccumulatingSpread": "warn"
      },
      "complexity": {
        "noForEach": "off"
      },
      "a11y": {
        "noSvgWithoutTitle": "off",
        "useKeyWithClickEvents": "off"
      },
      "correctness": {
        "noUnusedVariables": "warn",
        "noUnusedImports": "error",
        "noSwitchDeclarations": "off"
      },
      "nursery": {
        "useSortedClasses": "warn"
      }
    },
    "includes": [
      "**",
      "!**/node_modules",
      "!**/.next",
      "!**/dist",
      "!**/.wrangler",
      "!**/.react-email",
      "!**/.content-collections",
      "!**/meta",
      "!**/*.astro",
      "!**/.astro"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "enabled": true,
    "lineWidth": 80,
    "includes": [
      "**",
      "!**/node_modules",
      "!**/.next",
      "!**/dist",
      "!**/.nuxt",
      "!**/.wrangler",
      "!**/.react-email",
      "!**/.content-collections",
      "!**/meta",
      "!**/*.astro",
      "!**/.astro"
    ]
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
